{
	"name": "pixelguard-example-storybook-vite",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"pixelguard": "../../target/release/pixelguard",
		"pixelguard:test:visual": "npm run pixelguard test",
		"pixelguard:test:visual:update": "npm run pixelguard test --update",
		"pixelguard:test:plugins": "npm run pixelguard test -- --config pixelguard.plugins.config.json",
		"pixelguard:test:plugins:update": "npm run pixelguard test -- --update --config pixelguard.plugins.config.json"
	},
	"dependencies": {
		"react": "^19.2.6",
		"react-dom": "^19.2.6"
	},
	"devDependencies": {
		"@storybook/addon-links": "^10.4.0",
		"@storybook/react": "^10.4.0",
		"@storybook/react-vite": "^10.4.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"playwright": "^1.60.0",
		"storybook": "^10.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.13"
	}
}
